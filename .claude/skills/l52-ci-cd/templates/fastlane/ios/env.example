# Copy to: ios/fastlane/.env (gitignored)
# Fill in your App Store Connect API key credentials.
#
# To create an API key:
# 1. App Store Connect → Users and Access → Integrations → App Store Connect API
# 2. Generate API Key with "App Manager" role
# 3. Download the .p8 file (one-time download!)
# 4. Note the Key ID and Issuer ID

APP_STORE_CONNECT_KEY_ID=YOUR_KEY_ID
APP_STORE_CONNECT_ISSUER_ID=YOUR_ISSUER_ID
APP_STORE_CONNECT_KEY_PATH=/Users/you/.appstoreconnect/AuthKey_YOUR_KEY_ID.p8

# Optional: app name for IPA path (defaults to "Runner")
# APP_NAME=YourApp
